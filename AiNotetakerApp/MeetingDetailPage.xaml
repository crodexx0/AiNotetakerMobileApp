<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AiNotetakerApp.ViewModels"
             x:Class="AiNotetakerApp.MeetingDetailPage"
             x:DataType="viewmodels:MeetingDetailViewModel"
             Title="Meeting Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="{Binding CurrentMeeting.Title}" FontSize="24" FontAttributes="Bold"/>
            <Label Text="{Binding CurrentMeeting.StartTime, StringFormat='{0:f}'}" TextColor="Gray"/>

            <Label Text="AI Summary" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0"/>
            <Frame BackgroundColor="#F1F5F9" HasShadow="False" BorderColor="Transparent" CornerRadius="8">
                <Label Text="{Binding CurrentMeeting.AiSummary}" TextColor="#334155" />
            </Frame>

            <Label Text="Action Items" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0"/>
            <Frame BackgroundColor="#FEF3C7" HasShadow="False" BorderColor="Transparent" CornerRadius="8">
                <Label Text="{Binding CurrentMeeting.ActionItems}" TextColor="#92400E" />
            </Frame>

            <Label Text="Full Transcript" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0"/>
            <Label Text="{Binding CurrentMeeting.Transcript}" TextColor="#475569" LineBreakMode="WordWrap"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>