<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AiNotetakerApp.ViewModels"
             xmlns:models="clr-namespace:AiNotetakerApp.Models"
             x:Class="AiNotetakerApp.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="AI Notetaker">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️ Settings" Command="{Binding GoToSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <!-- A Grid allows us to layer UI elements on top of each other -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header Row -->
            <RowDefinition Height="*" />
            <!-- List Row takes up remaining space -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <!-- Header & Folders (Grid.Row="0") -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,0" Spacing="15">

            <!-- Title and New Folder Button -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="My Meetings" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Your transcripts and AI summaries" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>

                <Button Grid.Column="1" 
                        Text="+ Folder" 
                        Command="{Binding CreateFolderCommand}" 
                        BackgroundColor="#E2E8F0" 
                        TextColor="#1E293B" 
                        CornerRadius="8" 
                        HeightRequest="40" 
                        Padding="15,0"
                        VerticalOptions="Start"/>
            </Grid>

            <!-- Horizontal Folder List -->
            <CollectionView ItemsSource="{Binding Folders}"
                            SelectedItem="{Binding SelectedFolder}"
                            SelectionMode="Single"
                            HeightRequest="45">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Folder">
                        <!-- We use a Frame to make it look like a pill-shaped chip -->
                        <Frame Padding="15,0" CornerRadius="20" BorderColor="#0052cc" BackgroundColor="Transparent" HasShadow="False">
                            <Label Text="{Binding Name}" TextColor="#0052cc" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- The Meeting List -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Meetings}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding GoToDetailsCommand}"
                        SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">

            <!-- What to show when the database is empty -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="No meetings yet. 🎙️" TextColor="Gray" FontSize="18" HorizontalOptions="Center"/>
                    <Label Text="Tap the button below to add a test meeting." TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- How each individual meeting should look -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Meeting">
                    <Border Margin="15,8" Padding="15" Stroke="#E2E8F0" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                            <Label Text="{Binding StartTime, StringFormat='{0:MMM dd, yyyy - hh:mm tt}'}" FontSize="12" TextColor="#64748B" />

                            <!-- A snippet of the AI Summary -->
                            <Label Text="{Binding AiSummary}" 
                                   FontSize="14" 
                                   TextColor="#475569" 
                                   MaxLines="2" 
                                   LineBreakMode="TailTruncation" 
                                   Margin="0,5,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Spinner (Only visible when IsBusy is true) -->
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Color="#0052cc" />

        <!-- Floating Action Button layered on top of the bottom right corner -->
        <Button Grid.Row="1"
                Text="{Binding IsRecording, StringFormat='{0}'}"
                Command="{Binding ToggleRecordingCommand}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="150"
                FontAttributes="Bold"
                Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="False">
                    <Setter Property="Text" Value="🎙️ Record"/>
                    <Setter Property="BackgroundColor" Value="#0052cc"/>
                    <Setter Property="TextColor" Value="White"/>
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Text" Value="⏹ Stop Recording"/>
                    <Setter Property="BackgroundColor" Value="Red"/>
                    <Setter Property="TextColor" Value="White"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>

</ContentPage>
